  "agent_instructions": {
    "allowed_role": "organize sources, audit reports, and propose alternative designs",
    "must_do": [
      "separate evidence and interpretation",
      "show limitations",
      "preserve source provenance",
      "flag ethics and equity"
    ],
    "must_not_do": [
      "invent results",
      "fabricate citations",
      "write a submission without learner authorship"
    ],
    "human_accountability": "researcher owns design, interpretation, ethics, and communication"
